{
  "name": "dev-null-api",
  "version": "0.0.0",
  "description": "TypeScript client for the public, read-only dev-null.sh API",
  "keywords": [
    "dev-null"
  ],
  "homepage": "https://github.com/ryohidaka/dev-null-api#readme",
  "bugs": {
    "url": "https://github.com/ryohidaka/dev-null-api/issues"
  },
  "license": "MIT",
  "author": "ryohidaka <39184410+ryohidaka@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryohidaka/dev-null-api.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}
